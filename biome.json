{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": {
            "maxAllowedComplexity": 35
          }
        },
        "useOptionalChain": "error",
        "noImportantStyles": "off"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "performance": {
        "noImgElement": "off"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useConst": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.next",
      "!**/.next-test",
      "!**/.next-local",
      "!**/.demo-storage",
      "!**/.wrangler",
      "!**/coverage",
      "!**/coverage-tmp",
      "!**/playwright-report",
      "!**/test-results",
      "!**/.test-storage",
      "!**/.artifacts",
      "!**/.connector",
      "!**/.auth",
      "!**/drizzle",
      "!**/*.sql",
      "!**/*.d.ts",
      "!**/*.tsbuildinfo",
      "!**/bun.lock",
      "!**/logo.png",
      "!**/public",
      "!**/autoresearch.jsonl",
      "!**/CHANGELOG.md"
    ]
  },
  "overrides": [
    {
      "includes": ["docs/21-todos-feature.md", "docs/24-ai-link-suggestions.md"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["docs/20-frontend-design-review.md"],
      "markdown": {
        "formatter": {
          "formatEmbeds": false
        }
      }
    },
    {
      "includes": ["**/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off",
            "useFocusableInteractive": "off",
            "noStaticElementInteractions": "off"
          }
        }
      }
    },
    {
      "includes": ["**/scripts/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "correctness": {
            "noUnusedVariables": "warn"
          },
          "suspicious": {
            "noAssignInExpressions": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx", "**/tests/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "useArrowFunction": "off"
          },
          "correctness": {
            "noComponentHookFactories": "off"
          },
          "style": {
            "noUnusedTemplateLiteral": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noFocusedTests": "error",
            "noSkippedTests": "error"
          },
          "a11y": {
            "useAltText": "off"
          }
        }
      }
    }
  ]
}
