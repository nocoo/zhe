{
  "name": "@nocoo/zhe",
  "version": "1.24.5",
  "description": "CLI for managing zhe.to short links",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "zhe": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && cp src/connector/eagle-native.py dist/connector/eagle-native.py",
    "prepack": "bun run build",
    "dev": "tsc --watch",
    "test": "vitest run && python3 -m unittest discover -s tests -p eagle_native_test.py",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && python3 -m unittest discover -s tests -p eagle_native_test.py",
    "lint": "tsc --noEmit && biome check src/",
    "lint:fix": "biome check --write src/"
  },
  "dependencies": {
    "@jackwener/opencli": "1.8.7",
    "@nocoo/base-cli": "^0.3.0"
  },
  "engines": {
    "node": ">=22.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "26.5.1",
    "@vitest/coverage-v8": "5.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "keywords": [
    "zhe",
    "short-links",
    "url-shortener",
    "cli"
  ],
  "author": "nocoo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nocoo/zhe.git",
    "directory": "cli"
  },
  "overrides": {
    "esbuild": ">=0.28.1",
    "nanoid": ">=3.3.18",
    "postcss": ">=8.5.28",
    "vite": "^7.3.5"
  }
}
